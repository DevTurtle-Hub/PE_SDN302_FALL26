// Prisma Schema for PE_SDN302
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  expenses     Expense[]

  @@map("users")
}

model Expense {
  id        String   @id @default(uuid())
  userId    String
  title     String
  amount    Float
  category  String
  note      String   @default("")
  starred   Boolean  @default(false)
  spentAt   String   // Stored as YYYY-MM-DD
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, spentAt])
  @@map("expenses")
}
